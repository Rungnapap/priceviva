# PriceViva environment variables (internal identifiers still use the original "priceatlas"/"pa_" names)
# Copy to .env.local (never commit it). With nothing set, the site runs in FREE TEST MODE (DummyJSON sample data).

# ---------------------------------------------------------------------------
# Catalogue source (the admin switch overrides this):
#   sample = FREE TEST MODE: DummyJSON sample products + demonstration offers from data/sample-offers.csv (default)
#   live   = authorised real feeds (Awin) from Supabase — only used when the Supabase URL and anon key are set
#   demo   = built-in fictional catalogue (works offline)
CATALOG_SOURCE=sample
# Test mode options
SAMPLE_REFRESH_HOURS=6
# SAMPLE_OFFERS_CSV=data/sample-offers.csv

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Public read-only key ("anon" / "publishable"). Can only call the read-only pa_catalog_* functions.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Accounts (log in, sign up, password reset) use Supabase Auth with these same two public values.
# In Supabase -> Authentication -> URL Configuration, set Site URL to your site (http://localhost:3000 for local
# testing) and add <site>/auth/callback to Redirect URLs, or e-mail links won't come back to PriceViva.
# SERVER ONLY ("service_role" / "secret"). Used by the importer, admin and store-link redirect.
# Never prefix with NEXT_PUBLIC_, never commit, never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Awin publisher account
# Data-feed API key: Awin -> Toolbox -> Create-a-Feed -> copy the part after /apikey/ in the download link.
# (This is NOT the Publisher API OAuth token.)
AWIN_DATAFEED_API_KEY=
AWIN_PUBLISHER_ID=
# Safety rails: how many feeds may be enabled at once (start with 1), and max rows per import run.
AWIN_MAX_ENABLED_FEEDS=1
IMPORT_MAX_ROWS_PER_FEED=50000

# ---------------------------------------------------------------------------
# Scheduled import (Vercel Cron sends: Authorization: Bearer $CRON_SECRET). Generate: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin). Generate both lines with:  npm run admin:hash -- "a long password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Later: eBay / Amazon / direct retailer connectors (not implemented yet)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Amazon: only via an approved Associates programme API — variables added when that connector is built

# --- Local Deal Radar (optional) ---------------------------------------------
# Place/postcode search uses OpenStreetMap Nominatim (free, 1 request/second, identify yourself).
GEOCODER_CONTACT=
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER=off
# Map tiles (defaults to OpenStreetMap standard tiles — light use only). For production use a tile provider:
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Photo search: extra https image hosts the on-device index may read through /api/image-proxy (comma-separated),
# e.g. your retailer feed image hosts. DummyJSON's CDN is always allowed.
# IMAGE_PROXY_HOSTS=
# Countries searched by place/postcode lookup (default se,de,gb,no,dk,fi)
# GEOCODER_COUNTRIES=se,de,gb,no,dk,fi

# --- Price-alert e-mails (OFF by default; never sent in demo/sample/test mode) ------------------------------
# Only when ALL are set AND CATALOG_SOURCE=live with verified retailer feeds. See src/lib/server/alert-emails.ts.
# ALERT_EMAILS_ENABLED=false
# RESEND_API_KEY=                 # server only; an e-mail provider account is your decision (may cost money)
# ALERT_EMAIL_FROM=               # e.g. PriceViva <alerts@your-domain>, a domain verified with the provider
# ALERT_EMAIL_SECRET=             # 32+ random characters, signs unsubscribe links: openssl rand -hex 32
# Check schedule: call /api/cron/price-alerts with "Authorization: Bearer $CRON_SECRET" (e.g. Vercel Cron, daily).

# Public contact address shown on /contact (no contact form, no email backend). Leave empty until you publish one.
CONTACT_EMAIL=

# Search engines: keep "false" until real retailer data is live. Indexing is only allowed in live mode.
ALLOW_INDEXING=false
